# Demo local via Docker Compose (PBI-0070). Copie para `.env`:  cp .env.example .env
# NÃO versione `.env`. Os valores abaixo são apenas para demo local.

# >>> VALOR DE EXEMPLO — NÃO USE FORA DE DEMO LOCAL (mín. 32 caracteres). <<<
# Para outro ambiente gere um novo:  openssl rand -base64 48
JWT_SECRET=demo-only-do-not-use-in-any-real-env-0123456789

# Banco do compose (somente rede interna do compose; a porta não é publicada no host).
POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
# >>> SENHA DE EXEMPLO — NÃO USE FORA DE DEMO LOCAL. <<<
POSTGRES_PASSWORD=demo-only-change-me

# Porta publicada no host para a API.
API_PORT=8080

# Origens permitidas no CORS (lista separada por vírgula, sem barra final, sem "*").
# Aponte para o painel web, ex.: http://localhost:3000 (padrão) ou http://18.205.200.49
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Profiles Spring da API no compose.
#   dev,postgres -> Postgres + dados de demonstração (DevDemoSeed, só profile dev). Padrão da demo.
#   postgres     -> Postgres limpo, SEM seed e SEM usuários (comportamento de produção).
DEMO_PROFILES=dev,postgres
